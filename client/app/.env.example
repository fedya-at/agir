# Base URL for ASP.NET Core API and SignalR Hubs (no trailing slash)
# Production example: https://your-backend-api.onrender.com
# Development default: https://localhost:7143
VITE_API_BASE_URL=https://localhost:7143

# Base URL for Python Chatbot RAG Service
# Production example: https://your-chatbot-api.onrender.com/api/chatbot
# Development default: http://localhost:5000/api/chatbot
VITE_CHATBOT_URL=http://localhost:5000/api/chatbot
